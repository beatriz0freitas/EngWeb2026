extends layout

block content
  .w3-card-4
    header.w3-container.w3-teal
      h1 Lista de Exames Médicos Desportivos
    
    .w3-container
      p
        a.w3-btn.w3-blue.w3-margin-right(href='/emd?_sort=dataEMD&_order=desc') Data DESC ↓
        a.w3-btn.w3-green(href='/emd?_sort=nome.primeiro') Nome CRESC ↑
      table.w3-table-all.w3-margin-top
        tr
          th Nome 
          th Data
          th Modalidade
          th Resultado
        each t in list
          tr(onclick=`window.location='/emd/${t.id}'` style="cursor:pointer;")
            td= t.nome.primeiro + " " + t.nome.último
            td= t.dataEMD
            td= t.modalidade
            td= t.resultado ? 'Apto' : 'Inapto'
