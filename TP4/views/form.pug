extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h1= emd ? 'Editar Registo EMD' : 'Novo Registo EMD'

    form.w3-container.w3-padding(method='POST' action= emd ? `/emd/${emd.id}` : '/emd')
      if emd
        input(type='hidden' name='id' value=emd.id)
        input(type='hidden' name='index' value=emd.index)

      p
        label Nome Próprio
        input.w3-input.w3-border(type='text' name='primeiro' value= emd ? emd.nome.primeiro : '' required)
      p
        label Apelido
        input.w3-input.w3-border(type='text' name='ultimo' value= emd ? emd.nome['último'] : '' required)
      p
        label Data do EMD
        input.w3-input.w3-border(type='date' name='dataEMD' value= emd ? emd.dataEMD : '' required)
      p
        label Idade
        input.w3-input.w3-border(type='number' name='idade' value= emd ? emd.idade : '' min='1' max='120' required)
      p
        label Género
        select.w3-select.w3-border(name='género')
          option(value='M' selected= emd && emd['género'] === 'M') Masculino
          option(value='F' selected= emd && emd['género'] === 'F') Feminino
      p
        label Morada
        input.w3-input.w3-border(type='text' name='morada' value= emd ? emd.morada : '')
      p
        label Modalidade
        input.w3-input.w3-border(type='text' name='modalidade' value= emd ? emd.modalidade : '' required)
      p
        label Clube
        input.w3-input.w3-border(type='text' name='clube' value= emd ? emd.clube : '')
      p
        label Email
        input.w3-input.w3-border(type='email' name='email' value= emd ? emd.email : '')
      p
        label Federado?
        select.w3-select.w3-border(name='federado')
          option(value='true' selected= emd && emd.federado === true) Sim
          option(value='false' selected= emd && emd.federado === false) Não
      p
        label Resultado
        select.w3-select.w3-border(name='resultado')
          option(value='true' selected= emd && emd.resultado === true) Apto
          option(value='false' selected= emd && emd.resultado === false) Inapto

      p
        button.w3-btn.w3-purple(type='submit')= emd ? 'Atualizar' : 'Inserir'
        a.w3-btn.w3-grey.w3-margin-left(href='/emd') Cancelar
