doctype html
html
  head
    title= title
    meta(charset='UTF-8')
    link(rel='stylesheet' href='https://www.w3schools.com/w3css/4/w3.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
  body
    .w3-bar.w3-dark-grey
      a.w3-bar-item.w3-button(href='/') Filmes
      a.w3-bar-item.w3-button(href='/atores') Atores
      a.w3-bar-item.w3-button(href='/generos') Géneros
    .w3-container
      block content
    footer.w3-container.w3-dark-grey.w3-margin-top.w3-padding
      h5 Cinema App - EngWeb2026
    script.
      var p = location.pathname
      document.querySelectorAll('.w3-bar a').forEach(function(a) {
        var h = a.getAttribute('href')
        if (h === '/' ? !p.startsWith('/atores') && !p.startsWith('/generos') : p.startsWith(h))
          a.classList.add('w3-blue')
      })
