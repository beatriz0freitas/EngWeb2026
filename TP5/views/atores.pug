extends layout

block content
  h2 #{title} (#{atores.length})
  table.w3-table-all.w3-margin-top
    tr
      th ID
      th Nome
      th # Filmes
    each a in atores
      tr(onclick=`window.location='/atores/${a.id}'` style="cursor:pointer;")
        td= a.id
        td= a.name
        td= a.numFilms
