extends layout

block content
  .w3-card-4.w3-margin-top
    header.w3-container.w3-blue
      h2= ator.name
    .w3-container.w3-padding-16
      p
        b ID:
        |  #{ator.id}
      p
        b Filmes (#{ator.films ? ator.films.length : 0}):
      if ator.films && ator.films.length
        ul
          each f in ator.films
            li
              a(href=`/filmes/${f.id}`)= f.title
      else
        p.w3-text-grey Sem filmes registados.
    footer.w3-container.w3-light-grey.w3-padding-16
      a.w3-btn.w3-grey(href="/atores") Voltar
